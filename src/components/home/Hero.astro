---
import { Mail, FileText } from "@lucide/astro";
import { Github } from "simple-icons-astro";
import Resume from "@static/resume.pdf";
---

<section
  class="xs:py-30 xs:px-6 mx-auto flex max-w-6xl items-center justify-between py-0 md:py-25 lg:py-40"
>
  <div class="xs:space-y-10 md:space-y-10">
    <div>
      <h1 class="xs:text-4xl mb-2 font-bold sm:text-5xl">
        Hey, I'm Slade
        <span
          class="inline-block origin-[70%_70%] hover:animate-[wiggle_0.6s_ease-in-out]"
        >
          👋
        </span>
      </h1>
    </div>
    <p class="xs:text-xl text-subtle max-w-2xl md:text-2xl">
      Self-taught software engineer based in South Africa. Tinkering on Linux
      and coding in Go keeps me sane. Currently building {" "}
      <a
        href="/projects/tuwi"
        class="text-accent hover:bg-accent underline decoration-dashed underline-offset-4 transition-all duration-300 hover:tracking-[0.09rem] hover:text-(--rosepine-main-base)"
        >tuwi</a
      >
      , an open-source WiFi manager for Linux.
    </p>

    <div class="font-inter text-muted flex flex-wrap items-center gap-4">
      <a
        href="https://github.com/thecentinol"
        rel="noopener noreferrer"
        target="_blank"
        class="hover:text-accent flex items-center gap-2"
      >
        <Github size={20} />
        Github
      </a>
      <span>|</span>
      <a
        href="mailto:centinol@proton.me"
        rel="noopener noreferrer"
        target="_blank"
        class="hover:text-accent flex items-center gap-2"
      >
        <Mail size={20} />
        Email
      </a>

      <span>|</span>

      <a
        href={Resume}
        rel="noopener noreferrer"
        target="_blank"
        class="hover:text-accent flex items-center gap-2"
      >
        <FileText size={20} />
        Resume
      </a>

      <span>|</span>

      <span class="flex items-center"> Open to remote </span>
    </div>
  </div>
</section>
